# Todas las variables se validan al arrancar (src/config/env.validation.ts).
# Si falta o está mal alguna, la API no arranca y dice cuál.

# --- Servidor ---
# development | production | test (production activa reglas más estrictas)
NODE_ENV=development
PORT=3000
# URL pública de la API (en Render: https://lacarta-api.onrender.com)
PUBLIC_URL=http://localhost:3000
# Orígenes permitidos para CORS, separados por coma. Vacío = cualquiera (solo en desarrollo)
# Producción: CORS_ORIGINS=https://lacarta-web.onrender.com,https://tudominio.com
CORS_ORIGINS=

# --- Base de datos (PostgreSQL) ---
# Opción A: cadena de conexión completa (Neon, Supabase, Render…)
# DATABASE_URL=postgresql://usuario:password@host/basedatos?sslmode=require
# DB_SSL=true
# Opción B: Postgres local (docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=lacarta
DB_PASSWORD=lacarta
DB_NAME=lacarta
DB_SSL=false
# Desarrollo: DB_SYNC=true (TypeORM crea/ajusta las tablas solo).
# Producción: DB_SYNC=false y DB_MIGRATIONS_RUN=true (ver DEPLOY.md).
DB_SYNC=true
DB_MIGRATIONS_RUN=false
DB_LOGGING=false

# --- Autenticación ---
# Cámbialo por un texto largo y aleatorio (p. ej. `openssl rand -hex 32`)
JWT_SECRET=cambia-esto-por-un-secreto-largo
# Duración del token en segundos (86400 = 1 día)
JWT_EXPIRES_IN_SECONDS=86400

# --- Seed (npm run seed) ---
SUPERADMIN_EMAIL=superadmin@lacarta.app
SUPERADMIN_PASSWORD=CambiaEsto123
SUPERADMIN_NAME=Super Admin
# true = crea además un restaurante de prueba (burger_house) con su admin y menú
SEED_DEMO=true

# --- Archivos (imágenes, logos, comprobantes) ---
# local = disco del servidor (desarrollo) | cloudinary = producción
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Cloudinary (Dashboard -> API Keys). Basta con CLOUDINARY_URL:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_FOLDER=lacarta
