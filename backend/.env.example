# --- Servidor ---
PORT=3000
# URL pública de la API (se usa para armar las URLs de las imágenes subidas)
PUBLIC_URL=http://localhost:3000
# Orígenes permitidos para CORS, separados por coma. Vacío = cualquiera (solo en desarrollo)
CORS_ORIGINS=

# --- Base de datos (PostgreSQL) ---
# Opción A: cadena de conexión completa (p. ej. Supabase -> Project Settings -> Database)
# DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
# DB_SSL=true
# Opción B: Postgres local (docker-compose.yml)
DB_HOST=localhost
DB_PORT=5432
DB_USER=lacarta
DB_PASSWORD=lacarta
DB_NAME=lacarta
DB_SSL=false
# true = TypeORM crea/actualiza las tablas a partir de las entidades. Úsalo SOLO en desarrollo.
DB_SYNC=true
DB_LOGGING=false

# --- Autenticación ---
# Cámbialo por un texto largo y aleatorio (p. ej. `openssl rand -hex 32`)
JWT_SECRET=cambia-esto-por-un-secreto-largo
# Duración del token en segundos (86400 = 1 día)
JWT_EXPIRES_IN_SECONDS=86400

# --- Seed (npm run seed) ---
SUPERADMIN_EMAIL=superadmin@lacarta.app
SUPERADMIN_PASSWORD=CambiaEsto123
SUPERADMIN_NAME=Super Admin
# true = crea además un restaurante de prueba (burger_house) con su admin y menú
SEED_DEMO=true

# --- Archivos ---
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
